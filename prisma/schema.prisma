generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  name              String
  nickname          String?
  nicknameDealer    String?
  nicknameAdmin     String?
  nicknameChangedAt DateTime?
  birthdate         String?
  phone             String?
  role              Role     @default(USER)
  provider          String   @default("email")
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  favorites         Favorite[]
  inquiries         Inquiry[]
  purchases         Purchase[]
  blogPosts         BlogPost[]         @relation("BlogPosts")
  communityPosts    CommunityPost[]    @relation("CommunityPosts")
  communityComments CommunityComment[] @relation("CommunityComments")
  communityReports  CommunityReport[]  @relation("CommunityReports")
  dealerReviews     DealerReview[]     @relation("DealerReviews")
  wishAlerts        WishAlert[]        @relation("WishAlerts")
  catalogReports    CatalogReport[]    @relation("CatalogReports")
  carScores         CarScore[]         @relation("CarScores")
  mbti              UserMbti?          @relation("UserMbti")
}

enum Role {
  USER
  DEALER
  ADMIN
}

model Dealer {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  shopName    String
  shopDesc    String?  @db.Text
  shopPhone   String?
  shopAddr    String?
  complexName String?
  rating      Float    @default(0)
  dealCount   Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  cars        Car[]
  reviews     DealerReview[]
  banners     Banner[]
}

model Car {
  id           Int       @id @default(autoincrement())
  dealerId     Int
  dealer       Dealer    @relation(fields: [dealerId], references: [id])
  name         String
  brand        String
  year         Int
  mileage      Int
  fuel         String
  color        String
  region       String
  price        Int
  cc           Int       @default(0)
  power        Int       @default(0)
  efficiency   String    @default("0")
  transmission String    @default("자동")
  owners       Int       @default(1)
  accident     Boolean   @default(false)
  inspected    Boolean   @default(false)
  description  String?   @db.Text
  views        Int       @default(0)
  status       CarStatus @default(AVAILABLE)
  tags         String[]
  options      String[]
  images       String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  favorites    Favorite[]
  inquiries    Inquiry[]
  purchases    Purchase[]
  scores       CarScore[]
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
  REVIEWING
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  linkUrl   String?
  position  String   @default("CARS")
  dealerId  Int?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  active    Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  carId     Int
  user      User     @relation(fields: [userId], references: [id])
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, carId])
}

model Inquiry {
  id        Int           @id @default(autoincrement())
  userId    Int
  carId     Int
  user      User          @relation(fields: [userId], references: [id])
  car       Car           @relation(fields: [carId], references: [id])
  message   String
  reply     String?
  status    InquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum InquiryStatus {
  PENDING
  REPLIED
}

model Purchase {
  id          Int            @id @default(autoincrement())
  userId      Int
  carId       Int
  user        User           @relation(fields: [userId], references: [id])
  car         Car            @relation(fields: [carId], references: [id])
  amount      Int
  payType     String         @default("installment")
  status      PurchaseStatus @default(DEPOSIT_PAID)
  depositDate DateTime       @default(now())
  createdAt   DateTime       @default(now())
}

enum PurchaseStatus {
  DEPOSIT_PAID
  BALANCE_PENDING
  COMPLETED
  CANCELLED
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String   @default("")
  category  String   @default("구매 가이드")
  content   String   @db.Text
  products  Json     @default("[]")
  tags      Json     @default("[]")
  published Boolean  @default(true)
  authorId  Int
  author    User     @relation("BlogPosts", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityPost {
  id        Int                @id @default(autoincrement())
  title     String
  content   String             @db.Text
  category  String             @default("자유게시판")
  views     Int                @default(0)
  likes     Int                @default(0)
  authorId  Int
  author    User               @relation("CommunityPosts", fields: [authorId], references: [id])
  comments  CommunityComment[]
  reports   CommunityReport[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CommunityComment {
  id        Int           @id @default(autoincrement())
  content   String        @db.Text
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User          @relation("CommunityComments", fields: [authorId], references: [id])
  createdAt DateTime      @default(now())
}

model CommunityReport {
  id        Int           @id @default(autoincrement())
  postId    Int
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation("CommunityReports", fields: [userId], references: [id])
  category  String
  reason    String?       @db.Text
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  @@unique([postId, userId])
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  image     String?
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishAlert {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("WishAlerts", fields: [userId], references: [id], onDelete: Cascade)
  brand     String?
  model     String?
  minPrice  Int?
  maxPrice  Int?
  minYear   Int?
  maxYear   Int?
  fuel      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CatalogReport {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation("CatalogReports", fields: [userId], references: [id])
  carModel    String
  wrongInfo   String   @db.Text
  correctInfo String   @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model VisitorLog {
  id        Int      @id @default(autoincrement())
  ip        String
  userAgent String   @default("")
  referer   String   @default("")
  date      String
  createdAt DateTime @default(now())
}

model CarScore {
  id        Int      @id @default(autoincrement())
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("CarScores", fields: [userId], references: [id], onDelete: Cascade)
  category  String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([carId, userId, category])
}

model UserMbti {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation("UserMbti", fields: [userId], references: [id], onDelete: Cascade)
  type       String
  priorities String   @default("[]")
  scores     String   @default("{}")
  budget     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DealerReview {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("DealerReviews", fields: [userId], references: [id])
  rating    Int
  content   String?  @db.Text
  createdAt DateTime @default(now())
  @@unique([dealerId, userId])
}
